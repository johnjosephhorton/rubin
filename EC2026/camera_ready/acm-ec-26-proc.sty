% Formatting commands for ACM-EC 2023, with accompanying sample TeX file.
% hacks to the acmart class by Kevin Leyton-Brown; Jan 1 2017
% updated by Edith Elkind, Jan 2018
% updated by Jingyan Wang, Jan 2019
% tweaked, updated, and re-hacked for the latest acmart by Yannai Gonczarowski, Nov 2019
% tweaked, updated, and re-hacked for the latest acmart by Yannai Gonczarowski, Dec 2020
% updated by Sven Seuken and Yannai Gonczarowski, Jan 2022
% updated by Yannai Gonczarowski, Jan 2023
% updated by Dominik Peters and Yannai Gonczarowski, Jan 2024

\AtBeginDocument{
  \fancypagestyle{firstpagestyle}{% override header/footer style used by maketitle of acmart
	\renewcommand{\headrulewidth}{0pt}%
	\fancyhf{}%
	\fancyfoot{}%
  }%
  \fancypagestyle{acmec}{% header/footer style for pages other than the title page
	\renewcommand{\headrulewidth}{0pt}%
	\fancyhf{}%
        \fancyhead[LO]{\ACM@linecountL\@headfootfont\shorttitle}%
        \fancyhead[RE]{\@headfootfont\@shortauthors\ACM@linecountR}%
        \fancyhead[LE]{\ACM@linecountL\@headfootfont\footnotesize
            \acmConference@shortname,
            \acmConference@date, \acmConference@venue}%
          \fancyhead[RO]{\@headfootfont
            \acmConference@shortname,
            \acmConference@date, \acmConference@venue\ACM@linecountR}%
	\fancyfoot{}  }
  \pagestyle{acmec}
}
